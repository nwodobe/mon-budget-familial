# Configuration du backend Supabase.
#
# Ces deux valeurs sont PUBLIQUES : elles partent dans le bundle du navigateur.
# La protection des donnees repose sur Row Level Security, pas sur leur secret.
#
# N'y placez JAMAIS une cle service_role : l'application refuse de demarrer si
# elle en detecte une (src/data/supabase.ts).
#
# Sans ces variables, l'application fonctionne en local seul, sans sauvegarde.

VITE_SUPABASE_URL=https://VOTRE-REF.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
